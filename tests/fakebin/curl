#!/usr/bin/env bash
# Mock: curl – stellt Test-Assets bereit; HTTP-Checks gegen den systemd-State.
set -uo pipefail

STATE="${HARNESS_STATE:?HARNESS_STATE fehlt}"
mkdir -p "$STATE/curl-calls"

out=""
url=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
    a="${args[$i]}"
    case "$a" in
        -o | --output)
            out="${args[$((i + 1))]:-}"
            i=$((i + 1))
            ;;
        -*) ;;
        *) url="$a" ;;
    esac
done
echo "$url" >> "$STATE/curl-calls/urls.log"

case "$url" in
    *codeload.github.com*)
        [[ -n "$out" ]] || { echo "mock-curl: -o fehlt (codeload)" >&2; exit 1; }
        cp "${HARNESS_SRC_TARBALL:?HARNESS_SRC_TARBALL fehlt}" "$out"
        ;;
    *claude.ai/install.sh*)
        # Bootstrap-Script auf stdout pipen (wird von `| bash -s --` ausgeführt)
        cat "${HARNESS_ASSETS:?}/mock-bootstrap.sh"
        ;;
    *ttyd/releases/download/*ttyd.x86_64)
        [[ -n "$out" ]] || { echo "mock-curl: -o fehlt (ttyd)" >&2; exit 1; }
        # Gleiche Quelle wie die SHA256SUMS-Zeile unten → Checksumme stimmt.
        cp "${HARNESS_ASSETS:?}/mock-ttyd.sh" "$out"
        chmod +x "$out"
        ;;
    *ttyd/releases/download/*SHA256SUMS)
        [[ -n "$out" ]] || { echo "mock-curl: -o fehlt (SHA256SUMS)" >&2; exit 1; }
        sum=$(sha256sum "${HARNESS_ASSETS:?}/mock-ttyd.sh" | awk '{print $1}')
        printf '%s  ttyd.x86_64\n' "$sum" > "$out"
        ;;
    *downloads.claude.ai/claude-desktop/key.asc)
        [[ -n "$out" ]] || { echo "mock-curl: -o fehlt (claude-desktop key)" >&2; exit 1; }
        # Fake-Key mit dem erwarteten Fingerprint (der Installer prüft per gpg)
        printf -- '-----BEGIN PGP PUBLIC KEY BLOCK-----\nmock key for 31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE\n-----END PGP PUBLIC KEY BLOCK-----\n' > "$out"
        ;;
    http://127.0.0.1:*)
        # Web-Terminal-Check (Port 7681): 200 wenn claudecode-web aktiv ist
        if [[ "$url" == *":7681"* ]]; then
            if [[ -f "$STATE/systemd/claudecode-web.service.active" ]]; then
                printf '200'
            else
                printf '000'
            fi
        # Desktop-Check (Port 6080, noVNC): 200 wenn claudecode-desktop aktiv ist
        elif [[ "$url" == *":6080"* ]]; then
            if [[ -f "$STATE/systemd/claudecode-desktop.service.active" ]]; then
                printf '200'
            else
                printf '000'
            fi
        # Dashboard-Check (Port 8090, CloudCLI): 200 wenn claudecode-webui aktiv ist
        elif [[ "$url" == *":8090"* ]]; then
            if [[ -f "$STATE/systemd/claudecode-webui.service.active" ]]; then
                printf '200'
            else
                printf '000'
            fi
        else
            printf '200'
        fi
        ;;
    *)
        echo "mock-curl: unerwartete URL: $url" >&2
        exit 6
        ;;
esac
