[Unit]
Description=Claude Code Dauersession (tmux 'claude')
Documentation=https://github.com/HatchetMan111/ClaudeCodeServerProxmox
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
# Alte Session killen, falls vorhanden (macht Update/Re-Run idempotent)
ExecStartPre=-/usr/bin/tmux kill-session -t claude
ExecStart=/usr/bin/tmux new-session -d -s claude -c /root/claude-workspace /opt/claude-code/session.sh
ExecStop=/usr/bin/tmux kill-session -t claude
RemainAfterExit=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
