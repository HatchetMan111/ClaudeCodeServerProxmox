[Unit]
Description=Claude Code Web-Terminal (ttyd auf tmux 'claude')
Documentation=https://github.com/HatchetMan111/ClaudeCode-Proxmox
After=network-online.target claudecode-session.service
Wants=network-online.target

[Service]
# Port und Passwort: __PORT__ / __WEB_PASSWORD__ (vom Installer ersetzt).
# -W = schreibbar (Eingabe im Browser), -c = Basic-Auth für das Root-Terminal.
ExecStart=/usr/local/bin/ttyd -p __PORT__ -c claude:__WEB_PASSWORD__ -W /usr/bin/tmux attach -t claude
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
